{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "design_is_wrong",
    "blockers"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "design_is_wrong": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "failure_mode",
          "evidence",
          "closes_when"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "failure_mode": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "closes_when": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
